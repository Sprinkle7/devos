{
  "name": "@devaios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@devaios/config": "workspace:*",
    "@devaios/context-compression": "workspace:*",
    "@devaios/mcp-host": "workspace:*",
    "@devaios/providers": "workspace:*",
    "@devaios/secrets": "workspace:*",
    "@devaios/shared-kernel": "workspace:*",
    "@hono/node-server": "^1.14.3",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "postgres": "^3.4.7",
    "ws": "^8.21.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
