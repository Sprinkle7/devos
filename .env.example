# DEVAIOS local environment
# Copy to .env and adjust if needed.

DATABASE_URL=postgresql://ad@localhost:5432/devaios
# Docker Compose alternative:
# DATABASE_URL=postgresql://devaios:devaios@localhost:5432/devaios

API_PORT=8787
WEB_PORT=5173
DEVAIO_HOME=~/.devaios
HOST=127.0.0.1

# Secrets backend: file (default) or keychain (macOS only)
# DEVAIO_SECRETS_BACKEND=keychain
# DEVAIO_SECRETS_KEY=devaios-local-dev-key

# Encrypted backup passphrase (optional default for export)
# DEVAIO_BACKUP_PASSPHRASE=my-backup-secret

# Signed backups/archives use Ed25519 key at ~/.devaios/keys/backup-signing.json (auto-created on first sign)

# Backup schedule (also configurable via POST /backup/schedule)
# DEVAIO_BACKUP_SCHEDULE_ENABLED=0
# DEVAIO_BACKUP_SCHEDULE_INTERVAL_MINUTES=1440

# Backup retention defaults (also via POST /backup/retention): maxCount=20, maxAgeDays=30
# Archive export schedule via POST /export/conversations/archive/schedule
# Archive retention defaults (POST /export/conversations/archive/retention): maxCount=10, maxAgeDays=90
# Provider auto-disable cooldown: 15 min default (~/.devaios/providers/cooldown.json)
# Per-workspace job templates: ~/.devaios/job-templates.json
